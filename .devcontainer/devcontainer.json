{
  "name": "SAM 3D Objects Development",
  "dockerFile": "../Dockerfile",
  "context": "..",
  
  // Configure runtime options
  "runArgs": [
    "--gpus=all",
    "--shm-size=16gb",
    "--name=sam3d-dev"
  ],
  
  // Set environment variables
  "containerEnv": {
    "PIP_EXTRA_INDEX_URL": "https://pypi.ngc.nvidia.com https://download.pytorch.org/whl/cu121",
    "PIP_FIND_LINKS": "https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.5.1_cu121.html"
  },
  
  // VS Code customizations
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/sam3d-objects/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "python.formatting.blackPath": "/opt/conda/envs/sam3d-objects/bin/black",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true,
          "**/.pytest_cache": true
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ]
    }
  },
  
  // Use 'postCreateCommand' to run commands after the container is created
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  
  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root
  "remoteUser": "root",
  
  // Mount the workspace
  "workspaceFolder": "/workspace",
  
  // Forward ports
  "forwardPorts": [],
  
  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}
